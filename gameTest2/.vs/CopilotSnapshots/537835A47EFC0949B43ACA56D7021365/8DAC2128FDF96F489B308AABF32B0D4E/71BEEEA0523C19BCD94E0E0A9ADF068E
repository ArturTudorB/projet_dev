            _gameplayRenderer.DrawPlaying(
                _asteroids,
                _enemyTextures,
                _enemies,
                _buffTextures,
                _buffPickups,
                _laserTexture,
                _lasers,
                _playerTexture,
                _playerPosition,
                _shieldCharges,
                _totalPlayTime,
                _bossTextures,
                _bossActive,
                _currentBossTextureIndex,
                _bossPosition,
                _graphics.PreferredBackBufferWidth,
                _scoreInt,
                _playerHp,
                _playerName,
