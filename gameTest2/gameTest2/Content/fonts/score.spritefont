<?xml version="1.0" encoding="utf-8"?>
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>Arial</FontName>
    <Size>20</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <CharacterRegions>
      <!-- ASCII de base -->
      <CharacterRegion>
        <Start> </Start>
        <End>~</End>
      </CharacterRegion>
      <!-- Latin-1 (accents français usuels) -->
      <CharacterRegion>
        <Start>À</Start>
        <End>ÿ</End>
      </CharacterRegion>
      <!-- Ligatures françaises éventuelles -->
      <CharacterRegion>
        <Start>Œ</Start>
        <End>œ</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>